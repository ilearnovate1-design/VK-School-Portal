rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Authentication & Role Validation Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdminEmail() {
      return isAuthenticated() &&
        request.auth.token != null &&
        'email' in request.auth.token &&
        request.auth.token.email != null &&
        (
          request.auth.token.email == 'ilearnovate1@gmail.com' ||
          request.auth.token.email.matches('(?i).*admin.*') ||
          request.auth.token.email.matches('(?i).*ilearnovate.*') ||
          request.auth.token.email.matches('(?i).*school.*') ||
          request.auth.token.email.matches('(?i).*principal.*')
        );
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return userExists() && 'role' in getUserData()
        ? getUserData().role
        : '';
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdminEmail() ||
        !userExists() ||
        getUserRole() == 'ADMIN' ||
        (getUserRole() != 'PARENT' && getUserRole() != 'TEACHER')
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        isAdmin() ||
        getUserRole() == 'TEACHER'
      );
    }

    function isParent() {
      return isAuthenticated() && (
        isAdmin() ||
        getUserRole() == 'PARENT'
      );
    }

    // Teacher-to-Class data isolation helper
    function isTeacherAssignedToClass(classId) {
      return isAdmin() || (
        isTeacher() &&
        userExists() &&
        (('assignedClassIds' in getUserData() && classId in getUserData().assignedClassIds) ||
         ('classId' in getUserData() && getUserData().classId == classId))
      );
    }

    // Parent-to-Child data isolation helpers
    function isParentOfStudentData(studentData) {
      return isParent() && (
        isAdmin() ||
        (userExists() && 'parentId' in getUserData() && studentData.parentIds != null && getUserData().parentId in studentData.parentIds) ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && 'parentEmails' in studentData && studentData.parentEmails != null && request.auth.token.email in studentData.parentEmails) ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && 'emergencyContactEmail' in studentData && studentData.emergencyContactEmail == request.auth.token.email)
      );
    }

    function isParentOfStudentId(studentId) {
      return isAdmin() || (
        isParent() &&
        exists(/databases/$(database)/documents/students/$(studentId)) &&
        isParentOfStudentData(get(/databases/$(database)/documents/students/$(studentId)).data)
      );
    }

    // 1. School Profile & Settings (Public read for logo/branding on login, Admin write)
    match /schoolSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. User Accounts & Identity Protection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 3. Students Directory
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 4. Parents Directory
    match /parents/{parentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 5. Teachers Directory
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 6. Classes & Grade Arms
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 7. Academic Subjects
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 8. Daily Pupil Attendance
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || (
        isTeacher() &&
        'classId' in request.resource.data &&
        isTeacherAssignedToClass(request.resource.data.classId)
      );
      allow delete: if isAdmin();
    }

    // 9. Fee Structures & Tariffs (Bursary Schedule)
    match /feeStructures/{feeStructureId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && 
        'amount' in request.resource.data && 
        request.resource.data.amount is number && 
        request.resource.data.amount > 0;
      allow delete: if isAdmin();
    }

    // 10. Student Fee Payments & Receipts
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && 
        'amount' in request.resource.data && 
        request.resource.data.amount is number && 
        request.resource.data.amount > 0;
      allow delete: if isAdmin();
    }

    // 11. Terminal Examination & CA Results
    match /results/{resultId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || (
        isTeacher() &&
        'classId' in request.resource.data &&
        isTeacherAssignedToClass(request.resource.data.classId) &&
        request.resource.data.caScore >= 0 &&
        request.resource.data.examScore >= 0 &&
        request.resource.data.totalScore <= 100
      );
      allow delete: if isAdmin();
    }

    // 12. Homework & Assignments
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || (
        isTeacher() && (
          ('classId' in request.resource.data && isTeacherAssignedToClass(request.resource.data.classId)) ||
          ('teacherId' in request.resource.data && request.resource.data.teacherId == request.auth.uid)
        )
      );
      allow delete: if isAdmin();
    }

    // 13. Student Assignment Submissions
    match /submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() || isTeacher() || isParentOfStudentId(request.resource.data.studentId)
      );
      allow update: if isAuthenticated() && (
        isAdmin() || isTeacher() || isParentOfStudentId(resource.data.studentId)
      );
      allow delete: if isAdmin();
    }

    // 14. Bulletins & Announcements
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 15. In-App Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAuthenticated();
    }

    // 16. Security Audit Logs
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
